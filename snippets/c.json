{
  "Epitech main": {
    "prefix": "main",
    "description": "int main(int ac, char **av) returning 0",
    "body": [
      "int main(int ac, char **av)",
      "{",
      "    return ${1:0};",
      "}$0"
    ]
  },
  "Epitech function": {
    "prefix": "fn",
    "description": "A function with its description comment above it (C-F8)",
    "body": [
      "/*",
      "** ${1:Description}",
      "*/",
      "${2:int} ${3:get_value}(${4:void})",
      "{",
      "    ${5:return 0;}",
      "}$0"
    ]
  },
  "Epitech static function": {
    "prefix": "sfn",
    "description": "A static function with its description comment above it",
    "body": [
      "/*",
      "** ${1:Description}",
      "*/",
      "static ${2:int} ${3:get_value}(${4:void})",
      "{",
      "    ${5:return 0;}",
      "}$0"
    ]
  },
  "Epitech struct typedef": {
    "prefix": "tdef",
    "description": "typedef struct name_s { ... } name_t; (C-V1)",
    "body": [
      "typedef struct ${1:name}_s {",
      "    ${2:int value;}",
      "} ${1:name}_t;$0"
    ]
  },
  "Epitech enum typedef": {
    "prefix": "tenum",
    "description": "typedef enum name_e { ... } name_t; with an UPPER_SNAKE value (C-V1)",
    "body": [
      "typedef enum ${1:name}_e {",
      "    ${2:VALUE},",
      "} ${1:name}_t;$0"
    ]
  },
  "Epitech switch": {
    "prefix": "sw",
    "description": "A switch with two cases, default and their breaks",
    "body": [
      "switch (${1:value}) {",
      "    case ${2:0}:",
      "        ${3:value = 1;}",
      "        break;",
      "    case ${4:1}:",
      "        ${5:value = 2;}",
      "        break;",
      "    default:",
      "        ${6:value = 0;}",
      "        break;",
      "}$0"
    ]
  },
  "Epitech for loop": {
    "prefix": "fori",
    "description": "for (int i = 0; i < n; i++) with braces",
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:n}; ${1:i}++) {",
      "    ${3:break;}",
      "}$0"
    ]
  },
  "Epitech if else": {
    "prefix": "ife",
    "description": "if / else with braces",
    "body": [
      "if (${1:condition}) {",
      "    ${2:return 1;}",
      "} else {",
      "    ${3:return 0;}",
      "}$0"
    ]
  },
  "Epitech malloc": {
    "prefix": "mal",
    "description": "malloc with a NULL check returning NULL",
    "body": [
      "${1:ptr} = malloc(sizeof(${2:char}) * (${3:size}));",
      "if (${1:ptr} == NULL) {",
      "    return NULL;",
      "}$0"
    ]
  }
}
