#!/usr/bin/env bash
set -euo pipefail

EPITECH_NVIM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
export EPITECH_NVIM_DIR

# Per-project state lives in stdpath("data"): keep the tests away from the
# real one.
XDG_DATA_HOME="$(mktemp -d)"
export XDG_DATA_HOME
trap 'rm -rf "$XDG_DATA_HOME"' EXIT

while IFS= read -r file; do
    luac -p "$file"
done < <(find "$EPITECH_NVIM_DIR/lua" "$EPITECH_NVIM_DIR/after" "$EPITECH_NVIM_DIR/scripts" "$EPITECH_NVIM_DIR/test" -type f -name '*.lua' -print)

run() {
    nvim --clean --headless -u NONE -l "$EPITECH_NVIM_DIR/test/$1.lua"
}

run helpers-check
run nvim
run config
run project
run rules
run ts
run lsp
run clangd
run banana
run explain
run budget
run magic
run static
run types
run naming
run makefile
run void
run decl
run one_stmt
run switch
run struct_ptr
run extract
run header_sync
run move_header
run scaffold
run lib
run split
run snippets
run check
run make
run tests
run ignore
run hooks
run header-filetypes
run format-wrap

# These need the real epiclang, which isn't publicly available.
if command -v epiclang >/dev/null 2>&1; then
    run banana-real
    run snippets-real
    run calibrate
else
    printf '%s\n' 'Skipping Banana tests: epiclang is missing'
fi

# The formatter tests check the output with Banana, so they need epiclang and
# the Epitech Vim config the formatter runs.
if command -v epiclang >/dev/null 2>&1 && [ -f "${HOME}/.vim/epitech.vim" ]; then
    run format-guard
    run format-style
else
    printf '%s\n' 'Skipping formatter tests: epiclang or ~/.vim/epitech.vim is missing'
fi
